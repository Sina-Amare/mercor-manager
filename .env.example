# Copy to .env and fill in from your Supabase project settings.
# There is no hardcoded fallback any more: the app refuses to boot without these.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# No AI key belongs in this file. Anything with a VITE_ prefix is compiled into
# the bundle and readable by everyone who loads the page. The LLM key lives in
# the `ai` Edge Function instead — see docs/AI.md.
